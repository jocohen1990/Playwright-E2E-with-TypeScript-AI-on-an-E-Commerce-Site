# Copy to .env and fill in. Never commit the real .env.

# Existing account used by tests/setup/auth.setup.ts
LOGIN_EMAIL=
LOGIN_PASS=

# MailSlurp key, only needed for the sign-up test (tests/ui/sign-up.spec.ts)
MAIL_SLURP_API_KEY=
# Set to "true" to run the sign-up test (it creates a real inbox and account)
SIGN_UP_FLOW=false
